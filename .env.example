# ==========================================================
# KONFIGURASI ENVIRONMENT LAGUKAN DISCORD MUSIC BOT
# Developer: 666pallxXx
# Salin file ini menjadi .env: cp .env.example .env
# JANGAN PERNAH membagikan atau commit file .env Anda!
# ==========================================================

# --- Konfigurasi Discord Bot (WAJIB) ---
DISCORD_TOKEN=masukkan_token_bot_discord_anda_di_sini
DISCORD_CLIENT_ID=masukkan_application_client_id_anda_di_sini

# Opsional: Isi DISCORD_GUILD_ID jika ingin deploy Slash Command instan ke 1 server pengujian.
# Kosongkan untuk mendaftarkan Slash Command secara Global ke seluruh server.
DISCORD_GUILD_ID=

# Otomatis sinkronisasi Slash Commands saat bot menyala (true / false)
AUTO_DEPLOY_COMMANDS=false

# --- Konfigurasi Lavalink Server (WAJIB) ---
# Catatan: Lavalink adalah server audio berbasis Java yang berjalan terpisah dari proses Node.js bot.
LAVALINK_NAME=LaguKan-Main
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=masukkan_password_lavalink_anda_di_sini
LAVALINK_SECURE=false

# Pengaturan Reconnect & Pemulihan Lavalink (dalam detik)
LAVALINK_RECONNECT_TRIES=15
LAVALINK_RECONNECT_INTERVAL=5
LAVALINK_REST_TIMEOUT=45
LAVALINK_RESUME=true
LAVALINK_RESUME_TIMEOUT=60
LAVALINK_HEALTH_INTERVAL_MS=30000

# --- Konfigurasi Spotify Metadata (OPSIONAL) ---
# LaguKan mendukung pembacaan metadata Spotify (Track/Album/Playlist) dan mencocokkannya
# dengan sumber audio yang tersedia (YouTube Music / YouTube / SoundCloud).
# Jika server Lavalink Anda belum memasang plugin LavaSrc, isi Client ID & Secret dari
# https://developer.spotify.com/dashboard untuk dukungan penuh Album & Playlist besar.
# Tanpa kredensial ini, LaguKan tetap dapat membaca metadata dasar via Spotify oEmbed/Embed publik.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Pengaturan Default Pemutar Musik ---
# PENTING UNTUK ANDROID TERMUX ARM64:
# DEFAULT_VOLUME=100 mengaktifkan Pure-Java Opus Passthrough pada Lavalink/Lavaplayer
# sehingga stream Opus (YouTube WebM Opus & SoundCloud Ogg Opus) diteruskan ke Discord
# tanpa memuat library native glibc (libconnector.so / OpusDecoder / AacDecoderLibrary).
DEFAULT_VOLUME=100
MAX_VOLUME=200
MAX_QUEUE_SIZE=500
MAX_PLAYLIST_TRACKS=200
DEFAULT_SEARCH_SOURCE=ytmsearch
IDLE_TIMEOUT_SECONDS=120
MAX_FALLBACK_ATTEMPTS=2
TRACK_START_TIMEOUT_MS=15000

# --- Penyimpanan SQLite & Logging ---
DATABASE_PATH=./database/lagukan.sqlite
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/lagukan.log
