# ==========================================================
# CONTOH KONFIGURASI SERVER LAVALINK v4 UNTUK LAGUKAN
# Developer: 666pallxXx
# Salin menjadi application.yml di folder tempat Lavalink.jar berada.
# Pastikan server.password SAMA PERSIS dengan LAVALINK_PASSWORD di .env!
# ==========================================================

server:
  port: 2333
  address: 127.0.0.1
  http2:
    enabled: false

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    clients:
      - MUSIC
      - ANDROID_VR
      - WEB
      - WEBEMBEDDED

lavalink:
  plugins:
    # Plugin resmi YouTube untuk Lavalink v4
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.11.6"
      snapshot: false
    # Opsional: Aktifkan LavaSrc di bawah ini jika ingin pencocokan Spotify langsung di sisi Lavalink
    # - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.3.0"
    #   snapshot: false

  server:
    password: "GANTI_DENGAN_PASSWORD_KUAT_ANDA"
    sources:
      youtube: false # Dinonaktifkan di core karena digantikan oleh youtube-plugin v4 di atas
      bandcamp: true
      soundcloud: true
      twitch: true
      vimeo: true
      nico: false
      http: true
      local: false
    filters:
      volume: true
      equalizer: true
      karaoke: true
      timescale: true
      tremolo: true
      vibrato: true
      distortion: true
      rotation: true
      channelMix: true
      lowPass: true
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    opusEncodingQuality: 10
    resamplingQuality: MEDIUM
    trackStuckThresholdMs: 10000
    useSeekGhosting: true
    youtubePlaylistLoadLimit: 6
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true
    gc-warnings: true

metrics:
  prometheus:
    enabled: false

logging:
  file:
    path: ./logs/
  level:
    root: INFO
    lavalink: INFO
